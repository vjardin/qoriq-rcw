#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2026 Free Mobile -- Vincent Jardin

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
TESTS = disabled
else
TESTS = enabled
endif

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dtests=$(TESTS)

# The cross-validation suite needs a clone of nxp-qoriq/rcw.
override_dh_auto_test:
	dh_auto_test -- --suite unit
